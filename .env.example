# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
# Chọn MỘT trong hai nhà cung cấp:

# Option 1 — OpenAI
# OPENAI_API_KEY=sk-...

# Option 2 — Gemini (OpenAI-compatible endpoint, được code tự cấu hình)
GEMINI_API_KEY=your-gemini-api-key
# Lưu ý: Gemini free tier chỉ 20 requests/ngày/model.
# Code đã có ENRICH_MAX_CHUNKS + cache + circuit breaker để không vượt quota.
